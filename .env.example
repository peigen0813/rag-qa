# ============================================================
# 复制本文件为 .env，然后填入你自己的 Key。
# .env 已被 .gitignore 忽略，不会提交到 Git，也不要在截图里露出。
# ============================================================

# ---------- 对话模型（OpenAI 兼容接口）----------
# DeepSeek（国内推荐）：
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com/v1
OPENAI_MODEL=deepseek-chat

# 用 OpenAI 官方时改成：
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=
# OPENAI_MODEL=gpt-4o-mini

# 生成温度（0-1，越低越稳定）
OPENAI_TEMPERATURE=0.2

# ---------- 本地模型 ----------
# 嵌入模型：首次运行会自动下载（约 2GB）
RAG_EMBEDDING_MODEL=BAAI/bge-m3
# 重排模型：仅在 RAG_USE_RERANKER=true 时下载和使用
RAG_RERANK_MODEL=BAAI/bge-reranker-base
RAG_USE_RERANKER=false

# 国内下载 Hugging Face 模型加速；不需要就删掉这一行
HF_ENDPOINT=https://hf-mirror.com

# ---------- 切分 ----------
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=80

# ---------- 检索 ----------
RAG_TOP_K=5
RAG_CANDIDATE_K=20
RAG_RRF_K=60
# 相关性阈值：top 结果的向量相似度低于此值时走兜底回答
RAG_RELEVANCE_THRESHOLD=0.55

# ---------- 路径（一般不用改）----------
# RAG_DATA_DIR=data
# RAG_CHROMA_DIR=chroma_db
# RAG_COLLECTION=rag_docs
